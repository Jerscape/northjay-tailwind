---
import { wixClient } from "../../lib/wix.js";
import { media } from "@wix/sdk";
import BaseLayout from "../../layouts/BaseLayout.astro";

import IndividualService from "../../components/IndividualService.astro";
import ServiceHero from "../../components/ServiceHero.astro";
import lightening from "/images/lightening.png";




export async function getStaticPaths() {
  const results = await wixClient.items
    .query("ServiceCards")
    .eq("isActive", true)
    .ascending("order")
    .find({ consistentRead: true });

  console.log("=== CURRENTLY GENERATING ASTRO ROUTES ===");

  return results.items.map((service) => {
    // Fixed: Using clean template literals (backticks on both sides)
    console.log(`--> Generating route: /services/${service.slug}`);

    return {
      params: {
        slug: service.slug,
      },
      props: {
        service,
      },
    };
  });
}

const { service } = Astro.props;

---

<BaseLayout>
  <ServiceHero
    heroHeading={service.heroHeading}
    heroText={service.heroText}
    heroImage="/images/lightening.png"
  />

<IndividualService 
icon={service.icon} 
service_pitch_headline={service.service_pitch_headline}
/>

