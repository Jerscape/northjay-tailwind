---
import { wixClient } from "../../lib/wix.js";
import { media } from "@wix/sdk";
import BaseLayout from "../../layouts/BaseLayout.astro";

import IndividualService from "../../components/IndividualService.astro";
import ServiceHero from "../../components/ServiceHero.astro";
// import IconsServiceMenu from "../../components/IconsServiceMenu.astro";
import Footer from "../../components/Footer.astro";
import FormMain from "../../components/FormMain.astro";
import BookingCalendar from "../../components/BookingCalendar.astro";
import ServicesSection from "../../components/ServicesSection.astro";
import About from "../../components/About.astro";
import HubspotCalendar from "../../components/HubspotCalendar.astro";
import TechCheckupForm from "../../components/TechCheckupForm.astro";


export async function getStaticPaths() {
  const results = await wixClient.items
    .query("ServiceCards")
    .eq("isActive", true)
    .ascending("order")
    .find({ consistentRead: true });

  console.log("=== CURRENTLY GENERATING ASTRO ROUTES ===");

  return results.items.map((service) => {
    // Fixed: Using clean template literals (backticks on both sides)
    console.log(`--> Generating route: /services/${service.slug}`);

    return {
      params: {
        slug: service.slug,
      },
      props: {
        service,
      },
    };
  });
}

const { service } = Astro.props;

// If Wix sends a broken card without a hero heading, skip it completely!
// if (!service || !service.heroHeading) {
//   return Astro.redirect('/404');
// }

---

<BaseLayout>
  <ServiceHero
    heroHeading={service.heroHeading}
    hero_button_cta={service.hero_button_cta}
    heroText={service.heroText}
    heroImage="/images/robot_turned.png"
    book_btn_href={service.slug === "tech-checkup" ? "#calendar" : "#contact"}
/>
git 

<IndividualService 
icon={service.icon} 
service_pitch_headline={service.service_pitch_headline}

bulletHeading_1={service.bullet_heading_1}
bulletHeading_2={service.bullet_heading_2}
bulletHeading_3={service.bullet_heading_3}

bullet1={service.bullet1}
bullet2={service.bullet2}
bullet3={service.bullet3}

bottomCta={service.bottomCta}
/>

  {
    service.slug === "tech-checkup" ? (
      // <BookingCalendar
      //   serviceName={service.title_fld}
      //   contactFormHeader={service.contactFormHeader}

      <HubspotCalendar
        serviceName={service.title_fld}
        contactFormHeader={service.contactFormHeader}
        contactFormMessagePrompt={service.contactFormMessagePrompt}
       
      />
    ) : (
      <FormMain
        serviceName={service.title_fld}
        contactFormHeader={service.contactFormHeader}
        contactFormMessagePrompt={service.contactFormMessagePrompt}
      />
    )
  }

<About/>

{
  service.slug === "tech-checkup" && (
    <TechCheckupForm
      serviceName={service.title_fld}
      contactFormHeader={service.contactFormHeader}
      contactFormMessagePrompt={service.contactFormMessagePrompt}
    />
  )
}


<Footer></Footer>

</BaseLayout>