import ServiceHero from "../../components/ServiceHero.astro";
// import IconsServiceMenu from "../../components/IconsServiceMenu.astro";
import Footer from "../../components/Footer.astro";
import FormMain from "../../components/FormMain.astro";
import ServicesSection from "../../components/ServicesSection.astro";
import About from "../../components/About.astro";
import BookingCalendar from "../../components/BookingCalendar.astro";


export async function getStaticPaths() {
  const results = await wixClient.items
    .query("ServiceCards")
    .eq("isActive", true)
    .ascending("order")
    .find({ consistentRead: true });

  console.log("=== CURRENTLY GENERATING ASTRO ROUTES ===");

  return results.items.map((service) => {
    // Fixed: Using clean template literals (backticks on both sides)
    console.log(`--> Generating route: /services/${service.slug}`);

    return {
      params: {
        slug: service.slug,
      },
      props: {
        service,
      },
    };
  });
}

const { service } = Astro.props;

// If Wix sends a broken card without a hero heading, skip it completely!
