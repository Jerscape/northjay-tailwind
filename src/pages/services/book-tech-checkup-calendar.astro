---
import { wixClient } from "../../lib/wix.js";
import { media } from "@wix/sdk";
import BaseLayout from "../../layouts/BaseLayout.astro";

import IndividualService from "../../components/IndividualService.astro";
import ServiceHero from "../../components/ServiceHero.astro";
// import IconsServiceMenu from "../../components/IconsServiceMenu.astro";
import Footer from "../../components/Footer.astro";
import FormMain from "../../components/FormMain.astro";
import ServicesSection from "../../components/ServicesSection.astro";
import About from "../../components/About.astro";
import BookingCalendar from "../../components/BookingCalendar.astro";
import BookingTechCheckUpBullets from "../../components/BookingTechCheckUpBullets.astro";
import HubspotCalendar from "../../components/HubspotCalendar.astro";


const results = await wixClient.items
  .query("ServiceCards")
  .eq("slug", "tech-checkup")
  .eq("isActive", true)
  .limit(1)
  .find({ consistentRead: true });

const service = results.items[0];

if (!service) {
  throw new Error("Service card not found: tech-checkup");
}

const serviceTitle = service.title_fld;
const serviceDescription = service.description_fld;


// If Wix sends a broken card without a hero heading, skip it completely!
// if (!service || !service.heroHeading) {
//   return Astro.redirect('/404');
// }

---

<BaseLayout>


<HubspotCalendar
  contactFormHeader={service.contactFormHeader}

  />

