---
import { wixClient } from "../lib/wix.js";
import { media } from "@wix/sdk";
import ServiceCard from "./ServiceCard.astro";

const {
  icon,
  service_pitch_headline,
  bulletHeading_1,
  bulletHeading_2,
  bulletHeading_3,
  bullet1,
  bullet2,
  bullet3,
  bottomCta,
} = Astro.props;

const results = await wixClient.items
  .query("ServiceCards")
  .ascending("order")
  .find();

const serviceCards = results.items.map((card) => ({
  title: card.title_fld,
  description: card.description_fld,
  slug: card.slug,
  ctaLabel: card.ctaLabel,
  imageUrl: card.image_fld ? media.getImageUrl(card.image_fld).url : null,
  icon: card.icon,
}));
---

<div></div>

<section id="services" class="py-10 bg-slate-50">
  <div
    id="wrapper"
    class="max-w-6xl mx-auto px-4 mb-4 flex flex-col md:flex-row items-stretch md:items-start gap-8"
  >
    <div id="image-container" class="flex flex-col items-center shrink-0">
      <img
        src="/images/JeremyProfile.png"
        alt="Jeremy Dutton"
        class="w-75 h-auto rounded-full"
      />
      <figcaption class="mt-3 text-center text-base font-medium text-slate-600">
        Jeremy Dutton - CEO
      </figcaption>
    </div>

    <div
      id="right-column"
      class="w-full flex flex-col items-center gap-8 mt-8 md:mt-0"
    >
      <div id="text-container" class="w-full flex flex-col items-center gap-4">
        <p>
          I started my career on the business side before going back to school
          to study computer programming and software development. Since then, I
          have helped businesses improve how they use their websites, software
          tools, workflows, customer tracking, reporting, and everyday tech
          processes.
        </p>

        <p>
          I started Northjay because I saw a common problem: small businesses
          rely on technology every day, but often do not have someone available
          to help make that technology actually work for them. That is
          especially true for many small businesses and organizations in
          Northwestern Ontario, where teams are lean, budgets are practical, and
          people are often wearing a lot of different hats.
        </p>

        <p>
          My approach combines business analysis, project management, software
          knowledge, and process improvement. I do not just look at the tool
          itself. I look at how it fits into your work, your team, your
          customers, and your goals, so the technology you use supports the way
          your business actually runs.
        </p>
      </div>

      <a
        id="invitation"
        href="#contact"
        class="max-w-6xl mx-auto mt-25 px-6 py-3 text-left block"
      >
        <p class="statement-block">
          <strong>
            Have questions? I'm <span class="underline">always</span> up for a chat!
          </strong>
        </p>
      </a>
    </div>
  </div>
</section>
