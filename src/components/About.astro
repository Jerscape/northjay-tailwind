---
import { wixClient } from "../lib/wix.js";
import { media } from "@wix/sdk";
import ServiceCard from "./ServiceCard.astro";

const {
  icon,
  service_pitch_headline,
  bulletHeading_1,
  bulletHeading_2,
  bulletHeading_3,
  bullet1,
  bullet2,
  bullet3,
  bottomCta,
} = Astro.props;

const results = await wixClient.items
  .query("ServiceCards")
  .ascending("order")
  .find();

const serviceCards = results.items.map((card) => ({
  title: card.title_fld,
  description: card.description_fld,
  slug: card.slug,
  ctaLabel: card.ctaLabel,
  imageUrl: card.image_fld ? media.getImageUrl(card.image_fld).url : null,
  icon: card.icon,
}));
---

<div></div>

<section id="services" class="py-10 bg-slate-50">
  <div class="w-4/5 mx-auto">
    <div class="max-w-6xl mx-auto px-4 text-center mb-12">
      <h2 class="text-5xl font-bold text-slate-900 mb-4 mt-4">About</h2>
    </div>

    <div class="max-w-6xl mx-auto px-4 mb-4 flex items-center gap-8">
      <!-- NEW: This flex column container binds your image and caption together -->
      <div class="flex flex-col items-center shrink-0">
        <img
          src="/images/JeremyProfile.png"
          alt="Jeremy Dutton"
          class="w-75 h-auto rounded-full"
        />
        <figcaption class="mt-3 text-center text-sm font-medium text-slate-600">
          Jeremy Dutton - CEO
        </figcaption>
      </div>

      <ul class="space-y-4 flex-1">
        {/* Point 1 */}

        <li class="fact-ghost">
          <p>
            <strong>Twin Pillars of Experience: </strong>
            I started off my career in Business before going back to school to study
            computer programming and software. Since then I have assisted numerous
            businesses with improving how they use their tech tools. These twin pillars
            of experience allow me to bring unique insight into how business process
            and goals interact with technology. 
          </p>
        </li>

        {/* Point 2 */}

        <li class="fact-ghost">
          <p>
            <strong
              >Built for Small Businesses in Northwestern Ontario:
            </strong>
            I started Northjay because I saw a common problem: small businesses rely
            on technology every day, but they often do not have someone available
            to help make that technology actually work for them. That is especially
            true for many small businesses and organizations in Northwestern Ontario,
            where teams are often lean, budgets are practical, and people wear a lot
            of different hats.
          </p>
        </li>

        {/* Point 3 */}
        <li class="fact-ghost">
          <p>
            <strong>Practical Business Tech Support: </strong>
            My work focuses on practical business tech support: helping you choose
            the right tools, set them up properly, improve your workflows, and keep
            things running smoothly over time. That can include CRM systems, websites,
            automations, reporting, forms, spreadsheets, and day-to-day software processes.
            The goal is simple: make your technology work better for your business.
          </p>
        </li>
      </ul>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6 py-3 text-left">
    <p class="statement-block">
      <!-- <strong text-xl>{bottomCta}</strong> -->
      <strong>
        Have questions? I'm <span class="underline">always</span> up for a chat!
      </strong>
    </p>
    <!-- <div class="flex justify-center py-8"><i class="fa-sharp fa-solid fa-arrow-down text-[120px]"></i></div> -->
  </div>
</section>
