---
const {
  serviceName = "contactform",
  contactFormHeader = "Ready to Get Started?",
  contactFormMessagePrompt = "Let us know how we can help you",
} = Astro.props;
---

<section id="contact" class="flex flex-col bg-brand-purple">
  <h2
    class="text-brand-off-white mx-auto mb-15 mt-15 text-5xl font-bold text-center sm:w-300"
  >
    {contactFormHeader || "Ready to Get Started?"}
  </h2>
  <div
    class="mx-auto flex flex-col w-full sm:w-250 border-5 border-brand-orange rounded-sm border-solid p-5 bg-white mb-15"
  >
    <!-- Google Calendar Appointment Scheduling begin -->
    <iframe
      src="https://calendar.google.com/calendar/appointments/schedules/AcZssZ32eVZiipiLlqyg4HCEC8C5oTS3B7aGiOZhK6aZNJPqShNQP9_vMNb4BS2K1KzY3zfyv4gT5oI3?gv=true"
      style="border: 0"
      width="100%"
      height="750"
      frameborder="0"></iframe>
    <!-- end Google Calendar Appointment Scheduling -->
  </div>
  <!-- End of Meetings Embed Script -->
</section>



