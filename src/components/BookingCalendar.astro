---
const {
  serviceName = "contactform",
  contactFormHeader = "Ready to Get Started?",
  contactFormMessagePrompt = "Let us know how we can help you",
} = Astro.props;
---

<section id="contact" class="flex flex-col px-5 py-5">
  <h2 class="text-brand-off-white mx-auto mb-5 text-3xl font-bold text-center">
    {contactFormHeader || "Ready to Get Started?"}
  </h2>

<div class="mx-auto border-3 border-brand-off-purple rounded-sm border-solid w-150 inline-block">
    <div
    class="meetings-iframe-container w-150 "
    data-src="https://meetings-na3.hubspot.com/jeremy-dutton/business-tech-checkup?embed=true"
  >
  </div>
  <script
    type="text/javascript"
    src="https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js"
  ></script>
  <!-- End of Meetings Embed Script -->

</div>

  <div
    class="meetings-iframe-container border-5 border-solid border-brand-orange"
    data-src="https://meetings-na3.hubspot.com/jeremy-dutton/business-tech-checkup?embed=true"
  >
  </div>
  <script
    type="text/javascript"
    src="https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js"
  ></script>
  <!-- End of Meetings Embed Script -->
</section>
