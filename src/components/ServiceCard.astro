---
const { title, description, slug, ctaLabel, imageUrl, icon } = Astro.props;
---

<article
  class="rounded-lg border-2 border-brand-purple p-4 w-full min-h-50 flex flex-col"
>
  {
    imageUrl && (
      <img
        src={imageUrl}
        alt={title}
        class="h-48 w-full rounded object-cover"
      />
    )
  }
  <div class="mt-4 flex items-center gap-3">
    <i class={`${icon} text-2xl`} aria-hidden="true"></i>
    <h2 class="text-xl font-semibold">{title}</h2>
  </div>
  <p class="mt-2 min-h-20">{description}</p>

  <div class="mt-auto pt-5">
    <a
      href={`/services/${slug}`}
      class="inline-block rounded bg-brand-purple px-4 py-2 text-white font-semibold hover:bg-brand-orange"
    >
      {ctaLabel}
    </a>
  </div>
</article>
