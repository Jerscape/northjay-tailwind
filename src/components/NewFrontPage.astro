---
import { wixClient } from "../lib/wix.js";
import { media } from "@wix/sdk";
import ServiceCard from "./ServiceCard.astro";

const results = await wixClient.items
  .query("ServiceCards")
  .ascending("order")
  .find();

const serviceCards = results.items.map((card) => ({
  title: card.title_fld,
  description: card.description_fld,
  slug: card.slug,
  ctaLabel: card.ctaLabel,
  imageUrl: card.image_fld ? media.getImageUrl(card.image_fld).url : null,
  icon: card.icon,
}));
---

<section id="frontpage" class="py-16 bg-slate-50">

  <div class="max-w-6xl mx-auto px-4 text-center mb-12">
    <h2 class="text-5xl font-bold text-slate-900 mb-4">
    <span class="bg-gradient-to-t from-[var(--color-brand-orange)] to-transparent bg-[length:100%_25%] bg-no-repeat bg-bottom pb-1">
    IT'S A FACT: 
  </span>your business tech works better, when you don't do it alone.
  
    </h2>
  </div>

  <div class="max-w-6xl mx-auto px-4 mb-16 flex items-center gap-8">
    <div class="hidden lg:block shrink-0 text-slate-500 ">
      <!-- <i class="fa-regular fa-hand-back-point-right text-[160px]"></i> -->
      <!-- <i class="fa-solid fa-circle-caret-right text-[160px]"></i> -->
      <!-- <i class="fa-solid fa-comment-check text-[160px]"></i> -->
      <i class="fa-solid fa-computer text-[160px]"></i>

    </div>

    <ul class="space-y-4 flex-1">
      {/* Fact 1 */}

      <li
        class="fact-ghost"
      >
        <i class="fa-solid fa-comment-check text-[20px] text-brand-orange font-bold"></i>
        <p class="text-slate-700 text-2xl">
          <strong>It's impossible to know everything. </strong> 
        </p>
      </li>



      {/* Fact 2 */}
     <li
        class="fact-ghost"
      >
        <i class="fa-solid fa-comment-check text-[20px] text-brand-orange font-bold"></i>
        <p class="text-slate-700 text-2xl">
          <strong>Software only works when it's set up properly.</strong> 
      
        </p>
      </li>

            {/* Fact 3 */}
      <li
        class="fact-ghost"
      >
        <i class="fa-solid fa-comment-check text-[20px] text-brand-orange font-bold"></i>
        <p class="text-slate-700 text-2xl">
          <strong>Effective implementation & support saves time & money. </strong> 
        </p>
      </li>

      {/* Fact 4 */}
      <!-- <li
        class="fact-ghost"
      >
        <i class="fa-solid fa-comment-check text-[20px] text-brand-highlight font-bold py-4"></i>
        <p class="text-slate-700 text-lg">
          <strong>IMPLEMENTATION IS KEY: </strong> Guidance isn't enough. You need
          someone to take care of the details and just "make it work."
        </p>
      </li> -->
    </ul>
  </div>

<div class="max-w-6xl mx-auto px-4 text-left mb-12">
  <p class="statement-block text-left">
You may not need full-time IT staff, but having the right hands-on support can make your 
software, systems, and workflows work better for your business.
  </p>
</div>

<div class="max-w-6xl mx-auto text-left mb-12">
  <p class="statement-block">
    <strong>
      Let's talk about making <span class="bg-gradient-to-t from-[var(--color-brand-orange)] to-transparent bg-[length:100%_25%] bg-no-repeat bg-bottom pb-1">YOUR TECH</span> work better, together.
    </strong>
  </p>
  <!-- <div class="flex justify-center py-22 bg-brand-purple"><i class="fa-sharp fa-solid fa-arrow-down text-[120px] text-brand-off-white"></i></div> -->
</div>



  <div class="w-full md:w-3/4 mx-auto px-4" id="services">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        serviceCards.map((card) => (
          <ServiceCard
            title={card.title}
            description={card.description}
            slug={card.slug}
            ctaLabel={card.ctaLabel}
            imageUrl={card.imageUrl}
            icon={card.icon}
          />
        ))
      }
    </div>
  </div>
</section>
