---
import { wixClient } from "../lib/wix.js";
import { media } from "@wix/sdk";
import ServiceCard from "./ServiceCard.astro";

const {
  icon,
  service_pitch_headline,
  bulletHeading_1,
  bulletHeading_2,
  bulletHeading_3,
  bullet1,
  bullet2,
  bullet3,
  bottomCta,
} = Astro.props;

const results = await wixClient.items
  .query("ServiceCards")
  .ascending("order")
  .find();

const serviceCards = results.items.map((card) => ({
  title: card.title_fld,
  description: card.description_fld,
  slug: card.slug,
  ctaLabel: card.ctaLabel,
  imageUrl: card.image_fld ? media.getImageUrl(card.image_fld).url : null,
  icon: card.icon,
}));
---

<section id="redirectmain" class="py-5 bg-brand-purple min-h-150 flex items-center">
  <!-- Changed "flex items-center gap-8" to "flex flex-col md:flex-row items-center md:items-start gap-8" -->
  <div
    class="max-w-6xl mx-auto px-1 mb-4 flex flex-col-reverse md:flex-row items-center md:items-start gap-2"
    id="two-column"
  >
    <!-- NEW: This flex column container binds your image and caption together -->
    <div id="image-con" class="flex flex-col items-center shrink-0">
      <!-- Note: Ensure "w-75" is defined in your tailwind config, otherwise use "w-72" or a standard size -->
      <img
        src="/images/_robot_facing.png"
        alt="Jeremy Dutton"
        class="w-100 h-125"
      />
      <!-- <figcaption class="mt-3 text-center text-xl font-medium text-slate-600">
      We'll get back to you shortly!
    </figcaption> -->
    </div>

    <div
      id="thank-you-message"
      class="flex justify-center items-center min-h-[250px] flex-col gap-3 py-14"
    >
      <h1 class="text-5xl w-full font-bold mb-5 text-brand-off-white text-left px-5">
        Thank You! <br><br> Your Submission Was Successful.
      </h1>

      <ul class="space-y-4 ">
        {/* Point 1 */}
        <li id="redirect-li" class="fact-ghost">
          <p id="redirect-para" class="text-xl text-brand-off-white">
            <strong
              >Please check your email for a meeting invite and link. <br><br> 
              In
              the meantime, we encourage you to peruse our other services below.
              We bring a large breadth and depth of experience, and are happy to
              customize our offerings or packages to your needs.
            </strong>
          </p>
        </li>
      </ul>
    </div>
  </div>
</section>


