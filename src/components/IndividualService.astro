---
import { wixClient } from "../lib/wix.js";
import { media } from "@wix/sdk";
import ServiceCard from "./ServiceCard.astro";
const { icon, service_pitch_headline } = Astro.props;

const results = await wixClient.items
  .query("ServiceCards")
  .ascending("order")
  .find();

const serviceCards = results.items.map((card) => ({
  title: card.title_fld,
  description: card.description_fld,
  slug: card.slug,
  ctaLabel: card.ctaLabel,
  imageUrl: card.image_fld ? media.getImageUrl(card.image_fld).url : null,
  icon: card.icon,
}));
---

<div></div>

<section id="services" class="py-10 bg-slate-50">

<div class=" w-4/5 mx-auto">

  <div class="max-w-6xl mx-auto px-4 text-center mb-12">
    <h2 class="text-5xl font-bold text-slate-900 mb-4 mt-4">
     {service_pitch_headline}
    </h2>
  </div>

  <div class="max-w-6xl mx-auto px-4 mb-4 flex items-center gap-8">
    <div class="hidden lg:block shrink-0 text-slate-500 ">
      <!-- <i class="fa-regular fa-hand-back-point-right text-[160px]"></i> -->
      <!-- <i class="fa-solid fa-circle-caret-right text-[160px]"></i> -->
      <!-- <i class="fa-solid fa-comment-check text-[160px]"></i> -->
      <i class={`${icon} text-[160px]`}></i>

    </div>

    <ul class="space-y-4 flex-1">
      {/* Point 1 */}

<li class="fact-ghost">
  <i class="fa-solid fa-comment-check text-brand-highlight"></i>
  <p>
    <strong>Business-first, not just tech-focused: </strong> We aim to understand both your current tech setup and your business goals, so our recommendations support what you are actually trying to achieve.
  </p>
</li>


      {/* Point 2 */}
<li class="fact-ghost">
  <i class="fa-solid fa-comment-check text-brand-highlight"></i>
  <p>
    <strong>A thoughtful two-way conversation: </strong> You can ask questions, share context, and talk through what is working or not. Afterward, we’ll take time to reflect on what we heard and follow up in writing so you have something to reference.
  </p>
</li>

      {/* Point 3 */}
<li class="fact-ghost">
  <i class="fa-solid fa-comment-check text-brand-highlight"></i>
  <p>
    <strong>NO OBLIGATION: </strong> We hope you'll continue to work with us, but if not that's OK. We might follow up on occasion, <span class="underline bold decoration-2 font-bold font-style: italic">but we won't bombard you with marketing emails or calls.</span>
</li>
    </ul>
  </div>

<!-- <div class="max-w-6xl mx-auto px-4 text-left mb-12">
  <p class="statement-block text-center">
    Quick advice to get you started, no obligation. That's win-win.  
  </p>
</div> -->

<div class="max-w-6xl mx-auto px-6 py-3 text-left ">
  <p class="statement-block">
    <strong>
      Book your free call <span class="underline">TODAY</span> 
    </strong>
  </p>
  <!-- <div class="flex justify-center py-8"><i class="fa-sharp fa-solid fa-arrow-down text-[120px]"></i></div> -->
</div>

</div>
</section>


