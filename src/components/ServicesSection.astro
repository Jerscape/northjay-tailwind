---
import { wixClient } from "../lib/wix.js";
import { media } from "@wix/sdk";
import ServiceCard from "./ServiceCard.astro";

const results = await wixClient.items
  .query("ServiceCards")
  .ascending("order")
  .find();

const serviceCards = results.items.map((card) => ({
  title: card.title_fld,
  description: card.description_fld,
  slug: card.slug,
  ctaLabel: card.ctaLabel,
  imageUrl: card.image_fld ? media.getImageUrl(card.image_fld).url : null,
  icon: card.icon,
}));



---

<section id="services" class="py-12">
  <div class="w-full md:w-3/4 mx-auto px-4 md:px-0">
      <h2 class="text-3xl font-bold">Stop Just Fixing Problems. Start Winning with Your Tech.</h2>
  <p class="mt-3 text-xl">
  We serve small and medium-sized businesses to help you get more out of your software applications. For us, winning isn’t just fixing setup problems after they happen. It’s about being proactive. We plan and optimize your tech to actively drive growth, efficiency, and long-term success. That is what winning looks like.
  </p>

  <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {serviceCards.map((card) => (
      <ServiceCard
        title={card.title}
        description={card.description}
        slug={card.slug}
        ctaLabel={card.ctaLabel}
        imageUrl={card.imageUrl}
        icon={card.icon}
      />
    ))}
  </div>
  </div>
</section>

